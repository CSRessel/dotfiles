  "semanticTokenColors": {
    "type": "#08bdba",
    "class": "#08bdba",
    "interface": "#08bdba",
    "enum": "#08bdba",
    "enumMember": "#42be65",
    "typeParameter": "#08bdba",
    "namespace": "#08bdba",
    "function": "#78a9ff",
    "method": "#78a9ff",
    "macro": "#be95ff",
    "keyword": "#be95ff",
    "property": "#78a9ff",
    "variable": "#f2f4f8",
    "variable.readonly": "#42be65",
    "parameter": "#f2f4f8",
    "string": "#42be65",
    "number": "#f2cc60",
    "comment": "#8a8f98",
    "operator": "#08bdba",
    "decorator": "#f2cc60"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8a8f98" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "punctuation.definition.string", "meta.embedded.line.string"],
      "settings": { "foreground": "#42be65" }
    },
    {
      "name": "String escape / regex",
      "scope": ["constant.character.escape", "string.regexp", "constant.other.character-class.regexp"],
      "settings": { "foreground": "#08bdba" }
    },
    {
      "name": "Number and constant",
      "scope": ["constant.numeric", "constant.character", "keyword.other.unit"],
      "settings": { "foreground": "#f2cc60" }
    },
    {
      "name": "Language constant",
      "scope": ["constant.language", "constant.language.boolean", "constant.language.null", "variable.language.this", "variable.language.self", "variable.language.super"],
      "settings": { "foreground": "#42be65" }
    },
    {
      "name": "Other constant",
      "scope": ["constant.other", "support.constant", "variable.other.constant"],
      "settings": { "foreground": "#42be65" }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#be95ff" }
    },
    {
      "name": "Operator and punctuation.separator",
      "scope": ["keyword.operator", "punctuation.separator.key-value"],
      "settings": { "foreground": "#08bdba" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"],
      "settings": { "foreground": "#dde1e6" }
    },
    {
      "name": "Function",
      "scope": ["entity.name.function", "meta.function-call.generic", "support.function", "variable.function"],
      "settings": { "foreground": "#78a9ff" }
    },
    {
      "name": "Type / class",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.other.inherited-class", "support.type", "support.class", "storage.type.primitive"],
      "settings": { "foreground": "#08bdba" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other.readwrite", "meta.definition.variable.name", "entity.name.variable"],
      "settings": { "foreground": "#f2f4f8" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": { "foreground": "#f2f4f8" }
    },
    {
      "name": "Property / member",
      "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "support.type.property-name"],
      "settings": { "foreground": "#78a9ff" }
    },
    {
      "name": "Decorator / annotation",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "storage.type.annotation"],
      "settings": { "foreground": "#f2cc60" }
    },
    {
      "name": "Preprocessor",
      "scope": ["meta.preprocessor", "keyword.control.directive", "entity.name.function.preprocessor"],
      "settings": { "foreground": "#be95ff" }
    },
    {
      "name": "HTML / XML tag",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#be95ff" }
    },
    {
      "name": "HTML / XML attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#f2cc60" }
    },
    {
      "name": "CSS selector",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.name.tag.css"],
      "settings": { "foreground": "#08bdba" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal", "invalid.broken"],
      "settings": { "foreground": "#f47067" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#f2cc60", "fontStyle": "strikethrough" }
    },
    {
      "name": "Markdown heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#78a9ff", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#f2f4f8", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#dde1e6", "fontStyle": "italic" }
    },
    {
      "name": "Markdown strikethrough",
      "scope": ["markup.strikethrough"],
      "settings": { "fontStyle": "strikethrough" }
    },
    {
      "name": "Markdown link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#42be65", "fontStyle": "underline" }
    },
    {
      "name": "Markdown code / raw",
      "scope": ["markup.inline.raw", "markup.raw", "markup.fenced_code"],
      "settings": { "foreground": "#42be65" }
    },
    {
      "name": "Markdown list marker",
      "scope": ["punctuation.definition.list.begin.markdown", "beginning.punctuation.definition.list"],
      "settings": { "foreground": "#42be65" }
    },
    {
      "name": "Markdown quote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#8a8f98", "fontStyle": "italic" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#42be65" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#f47067" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#f2cc60" }
    },
    {
      "name": "JSON key",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#78a9ff" }
    },
    {
      "name": "YAML key",
      "scope": ["entity.name.tag.yaml"],
      "settings": { "foreground": "#78a9ff" }
    },
    {
      "name": "Shell built-in",
      "scope": ["support.function.builtin.shell", "entity.name.command"],
      "settings": { "foreground": "#78a9ff" }
    },
    {
      "name": "Embedded punctuation (template interpolation)",
      "scope": ["punctuation.section.embedded", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#08bdba" }
    }
  ]
}
