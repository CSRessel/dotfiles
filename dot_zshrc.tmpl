# Interactive Zsh configuration. Shared commands live in ~/.sh_aliases.

# ---- Oh My Zsh ----

export ZSH=$HOME/.oh-my-zsh
export PATH="$HOME/.local/bin:$PATH"
ZSH_THEME="robbyrussell"
plugins=(
    git
    vi-mode
    kubectl
)

# Keep built-in command names intact when loading Oh My Zsh.
zstyle ':omz:*' aliases no
[[ -r "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"
{{ if eq .chezmoi.username "clifford.ressel" }}
# Show the Kubernetes context in the work prompt.
RPROMPT='%{$fg[blue]%}($ZSH_KUBECTL_PROMPT)%{$reset_color%}'
{{ end }}
# ---- Editor and keybindings ----

bindkey -v

for editor in nvim vim nano vi; do
    if command -v "$editor" >/dev/null 2>&1; then
        export VISUAL="$editor" EDITOR="$editor"
        break
    fi
done
unset editor
{{ if has "dev-tools" (get . "modules" | default (list)) }}
# ---- Development tools and PATH ----

{{ template "dev-tools-env" . -}}
{{ end }}
# ---- Completions and direnv ----
{{ if has "dev-tools" (get . "modules" | default (list)) }}
{{ template "dev-tools-completions" . -}}
{{ end }}
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"

# ---- Shared aliases and work settings ----

# Load after PATH setup so dependency checks can find installed tools.
if [ -f ~/.sh_aliases ]; then
    source ~/.sh_aliases
fi
{{ if eq .chezmoi.username "cressel" }}
# Additional settings for the work account.
if [ -f ~/.sh_work ]; then
    source ~/.sh_work
fi
{{ end }}
# ---- Terminal compatibility ----

# Fix mosh advertising TERM=xterm instead of xterm-256color
if [[ "$TERM" == "xterm" ]] || [[ "$TERM" == xterm-* ]]; then
    export TERM="xterm-256color"
fi

# Set COLORTERM if not already set and terminal supports it
if [[ -z "$COLORTERM" ]]; then
    if [[ -n "$MOSH_CONNECTION" ]] || [[ "$TERM" == *-256color ]] || [[ "$TERM" == xterm-kitty ]] || [[ "$TERM" == alacritty ]]; then
        export COLORTERM="truecolor"
    fi
fi

# ---- Login contribution graph ----

# Display once per interactive login shell.
if [[ -o login ]] && command -v githubgraph >/dev/null 2>&1; then
    githubgraph -w 12 -l -c
fi
