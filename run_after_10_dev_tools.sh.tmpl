{{ if has "dev-tools" (get . "modules" | default (list)) -}}
#!/bin/bash
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
command -v mise >/dev/null || { echo 'Install mise first: https://mise.jdx.dev/installing-mise.html' >&2; exit 1; }
# An empty config search root keeps the invoking project's tools out of setup.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# Successful checks are silent; failures retain their full diagnostics.
quiet() {
    "$@" > "$work/setup.log" 2>&1 || {
        result=$?
        cat "$work/setup.log" >&2
        return "$result"
    }
}
cd "$work"
export MISE_CEILING_PATHS="$work"
unset RUSTUP_TOOLCHAIN
quiet mise install
# Activate only in this script, not in interactive shells alongside direnv.
mise_env=$(mise env -s bash)
eval "$mise_env"

# Aqua exposes rustup; installer mode is selected by the rustup-init filename.
cargo_rustup="${CARGO_HOME:-$HOME/.cargo}/bin/rustup"
if ! cmp -s "$(command -v rustup)" "$cargo_rustup"; then
    # Copy the binary: rustup can preserve an installer symlink in CARGO_HOME,
    # leaving every Cargo proxy broken when this temporary directory is removed.
    cp "$(command -v rustup)" "$work/rustup-init"
    # Repair links left by earlier symlink-based installer staging.
    if [ -L "$cargo_rustup" ] && [ ! -e "$cargo_rustup" ]; then
        unlink "$cargo_rustup"
    fi
    quiet "$work/rustup-init" -y --no-modify-path --default-toolchain none
fi
quiet rustup set auto-self-update disable
{{ $pins := (include "dot_config/mise/config.toml" | fromToml).vars -}}
quiet rustup toolchain install {{ $pins.rust_bootstrap }} --profile minimal --component rustfmt,clippy,rust-src
rustup default >/dev/null 2>&1 || quiet rustup default {{ $pins.rust_bootstrap }}
quiet uv python install {{ $pins.python_bootstrap }}
{{- end }}
