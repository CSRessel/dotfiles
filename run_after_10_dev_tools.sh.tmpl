{{ if has "dev-tools" (get . "modules" | default (list)) -}}
#!/bin/bash
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
command -v mise >/dev/null || { echo 'Install mise first: https://mise.jdx.dev/installing-mise.html' >&2; exit 1; }
# An empty config search root keeps the invoking project's tools out of setup.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cd "$work"
export MISE_CEILING_PATHS="$work"
unset RUSTUP_TOOLCHAIN
mise install
# Activate only in this script, not in interactive shells alongside direnv.
eval "$(mise env -s bash)"

# Aqua exposes rustup; installer mode is selected by the rustup-init filename.
if ! cmp -s "$(command -v rustup)" "${CARGO_HOME:-$HOME/.cargo}/bin/rustup"; then
    ln -s "$(command -v rustup)" "$work/rustup-init"
    "$work/rustup-init" -y --no-modify-path --default-toolchain none
fi
rustup set auto-self-update disable
{{ $pins := (include "dot_config/mise/config.toml" | fromToml).vars -}}
rustup toolchain install {{ $pins.rust_bootstrap }} --profile minimal --component rustfmt,clippy,rust-src
rustup default >/dev/null 2>&1 || rustup default {{ $pins.rust_bootstrap }}
uv python install {{ $pins.python_bootstrap }}
{{- end }}
