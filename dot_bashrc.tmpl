# Interactive Bash fallback. Shared commands live in ~/.sh_aliases.

# ---- Startup guards ----

case $- in
    *i*) ;;
    *) return ;;
esac

# A login .profile may already have sourced this file.
[ "${dotfiles_bashrc_loaded:-}" != 1 ] || return
dotfiles_bashrc_loaded=1

# ---- History and shell options ----

# Ignore duplicates and leading-space commands; append across sessions.
HISTCONTROL=ignoreboth
shopt -s histappend
HISTSIZE=1000
HISTFILESIZE=2000

# Keep LINES and COLUMNS current after resizing.
shopt -s checkwinsize

[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# ---- Prompt and colors ----

if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

case "$TERM" in
    xterm-color|*-256color) color_prompt=yes ;;
esac

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
        color_prompt=yes
    else
        color_prompt=
    fi
fi

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

# Set the terminal title to user@host:directory.
case "$TERM" in
    xterm*|rxvt*)
        PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
        ;;
    *) ;;
esac

if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    : # Keep standard commands unchanged.
fi

# Bash-specific shortcuts; shared aliases load below.
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Notify when a long command finishes: sleep 10; alert
command -v notify-send >/dev/null 2>&1 && alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# ---- Completions ----

if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi

# ---- Development tools and direnv ----

export PATH="$HOME/.local/bin:$PATH"

{{ if has "dev-tools" (get . "modules" | default (list)) -}}
{{ template "dev-tools-env" . }}
{{ template "dev-tools-completions" . -}}
{{ end -}}

command -v direnv >/dev/null 2>&1 && eval "$(direnv hook bash)"

# ---- Editor and shared aliases ----

for editor in lvim nvim vim nano vi; do
    if command -v "$editor" >/dev/null 2>&1; then
        export VISUAL="$editor" EDITOR="$editor"
        break
    fi
done
unset editor

[ ! -r "$HOME/.sh_aliases" ] || . "$HOME/.sh_aliases"
