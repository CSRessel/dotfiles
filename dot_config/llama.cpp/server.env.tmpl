{{- $config := get . "llamaCpp" | default dict -}}
# Native llama-server settings, read by the systemd user service.
# Change machine-specific values in chezmoi's [data.llamaCpp] table.
LLAMA_ARG_MODEL={{ get $config "model" | default (joinPath .chezmoi.homeDir ".local/share/llama.cpp/models/model.gguf") | quote }}
LLAMA_ARG_CTX_SIZE={{ get $config "context" | default 16384 }}
LLAMA_ARG_DEVICE={{ get $config "device" | default "Vulkan0" | quote }}
LLAMA_ARG_N_GPU_LAYERS=999
LLAMA_ARG_FLASH_ATTN=on
LLAMA_ARG_N_PARALLEL=1
LLAMA_ARG_HOST=127.0.0.1
LLAMA_ARG_CORS_ORIGINS=localhost
LLAMA_ARG_PORT={{ get $config "port" | default 8080 }}
