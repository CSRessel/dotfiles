# Framework Laptop 13 Pro (Intel Core Ultra Series 3), internal AT keyboard only.
# Scan codes verified with evtest on this laptop. USB/Bluetooth devices do not match.
# udev sanitizes DMI parentheses to underscores during rule expansion.
evdev:atkbd:dmi:*:svnFramework:pnLaptop13Pro_IntelCoreUltraSeries3_:*
 KEYBOARD_KEY_b8=esc
 KEYBOARD_KEY_3a=leftctrl
 KEYBOARD_KEY_1d=volumedown
 KEYBOARD_KEY_01=capslock
 KEYBOARD_KEY_36=rightalt
