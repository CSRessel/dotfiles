# Applies to every tmux pane scope (tmux-spawn-<uuid>.scope) via systemd's
# truncated-prefix drop-in matching. Motivated by two incidents where a
# runaway process in a pane (50 GB python3 on 2026-07-06, 49 GB bun test on
# 2026-07-07) exhausted 61 GB RAM + swap, dragged the whole machine into
# swap-thrash, and the global OOM kill then failed the entire pane scope.
#
# MemoryHigh throttles the scope's reclaim before it can pressure the rest of
# the system; MemoryMax is the hard cap that turns a runaway into a targeted
# in-cgroup OOM kill; MemorySwapMax keeps a capped scope from thrashing swap
# instead of dying; OOMPolicy=continue means only the killed process dies,
# not the pane.
{{- $limits := get . "tmuxMemory" | default dict -}}
{{- range $key := list "high" "max" "swap" -}}
{{- $value := get $limits $key | default "" -}}
{{- if not (regexMatch `^([0-9]+(\.[0-9]+)?[KMGTPE]?|[0-9]+(\.[0-9]+)?%)$` $value) -}}
{{- fail (printf "Set data.tmuxMemory.%s to a size (e.g. 24G) or percentage before enabling tmux-memory" $key) -}}
{{- end -}}
{{- end }}
[Scope]
MemoryHigh={{ $limits.high }}
MemoryMax={{ $limits.max }}
MemorySwapMax={{ $limits.swap }}
OOMPolicy=continue
