{{- /* whisper.cpp dictation toggle — only if the vulkan build and model are present */ -}}
{{ $whisperBin := joinPath .chezmoi.homeDir "Documents/builds/whisper.cpp/build-vulkan/bin/whisper-cli" }}
{{ $whisperModel := joinPath .chezmoi.homeDir "Documents/builds/whisper.cpp/models/ggml-base.en.bin" }}
{{ if and (stat $whisperBin) (stat $whisperModel) }}
if commandsAvailable parecord && { commandsAvailable wl-copy || commandsAvailable xclip; }; then
# whisper.cpp dictation
#   wsp        : interactive — press [Enter] to stop, colored inline output
#   wsp-toggle : toggle-style for DE keyboard shortcut (see ~/.local/bin/wsp-toggle)
alias wsp-toggle="$HOME/.local/bin/wsp-toggle"
wsp() {
    local rec whisper model text
    rec=$(mktemp --suffix=.wav)
    whisper=~/Documents/builds/whisper.cpp/build-vulkan/bin/whisper-cli
    model=~/Documents/builds/whisper.cpp/models/ggml-base.en.bin

    printf '\033[1;31m●\033[0m \033[1mRecording...\033[0m press [Enter] to stop '
    parecord --channels=1 --rate=16000 --file-format=wav "$rec" 2>/dev/null &
    local pid=$!
    read -r
    kill -INT $pid 2>/dev/null; wait $pid 2>/dev/null

    printf '\r\033[K\033[1;33m…\033[0m transcribing\n'
    text=$("$whisper" -m "$model" -f "$rec" -nt -np 2>/dev/null \
            | sed 's/^ *//;s/ *$//' | tr '\n' ' ' | sed 's/ *$//')
    command rm -f "$rec"

    if command -v wl-copy >/dev/null; then
        printf '%s' "$text" | wl-copy
    else
        printf '%s' "$text" | xclip -selection clipboard
    fi
    printf '\033[1;32m✓\033[0m %s\n' "$text"
}
fi
{{- end }}

{{- /* Trash directory support for safe rm */ -}}
{{ $hasTrash := false }}
{{ $trashCommand := "" }}
{{ $trashDir := joinPath .chezmoi.homeDir ".local/share/Trash" }}

{{- if lookPath "gio" -}}
{{ $hasTrash = true }}
{{ $trashCommand = "gio trash" }}
{{- else if lookPath "trash-put" -}}
{{ $hasTrash = true }}
{{ $trashCommand = "trash-put" }}
{{- else if stat $trashDir -}}
{{ $hasTrash = true }}
{{ $trashCommand = "custom_trash" }}
{{- end }}

{{ if $hasTrash }}
# Safe rm wrapper - moves files to trash instead of permanent deletion
TRASH_DIR="{{ $trashDir }}"

{{ if eq $trashCommand "custom_trash" }}
# Custom trash implementation for systems without gio/trash-cli
custom_trash() {
    local trash_files="$TRASH_DIR/files"
    local trash_info="$TRASH_DIR/info"
    
    mkdir -p "$trash_files" "$trash_info"
    
    for file in "$@"; do
        if [ ! -e "$file" ]; then
            echo "trash: cannot trash '$file': No such file or directory" >&2
            continue
        fi
        
        local basename=$(basename "$file")
        local timestamp=$(date +%Y-%m-%dT%H:%M:%S)
        local abs_path=$(realpath "$file")
        
        # Handle name collisions
        local dest_name="$basename"
        local counter=1
        while [ -e "$trash_files/$dest_name" ]; do
            dest_name="${basename}.${counter}"
            counter=$((counter + 1))
        done
        
        # Move file to trash
        mv "$file" "$trash_files/$dest_name"
        
        # Create .trashinfo metadata
        cat > "$trash_info/${dest_name}.trashinfo" <<EOF
[Trash Info]
Path=$abs_path
DeletionDate=$timestamp
EOF
    done
}
{{ end }}

safe_rm() {
    local force_delete=0
    local trash_args=()
    
    # Check for --really-delete flag to bypass trash
    for arg in "$@"; do
        if [ "$arg" = "--really-delete" ] || [ "$arg" = "--force-delete" ]; then
            force_delete=1
        else
            trash_args+=("$arg")
        fi
    done
    
    if [ $force_delete -eq 1 ]; then
        command rm "${trash_args[@]}"
    else
        {{ $trashCommand }} "${trash_args[@]}"
    fi
}

# Alias rm to safe_rm (users can still use \rm or command rm to bypass)
alias rm='safe_rm'
{{ end }}

# Fuzzy finders (fzf vim, fzf make, fzf git log)
if commandsAvailable fzf-tmux tmux lvim && { commandsAvailable fd || commandsAvailable fdfind; }; then
fvim() {
    local finder file
    finder=$(command -v fd || command -v fdfind)
    "$finder" --type f --hidden --exclude .git --print0 |
        fzf-tmux -p -- --read0 --print0 --exit-0 |
        while IFS= read -r -d '' file; do
            lvim "$file" < /dev/tty
        done
}
fi
if commandsAvailable make fzf; then
fmake() {
  local target=$(make -qp | awk -F':' '/^[a-zA-Z0-9][^$#\/\t=]*:([^=]|$)/ {split($1,A,/ /);for(i in A)print A[i]}' | sort -u | fzf --header="Select Makefile Target")
  [ -n "$target" ] && make "$target"
}
fi
if commandsAvailable git fzf; then
flog() {
    local selection=$(
      git lo --color=always "$@" | \
        fzf --no-multi --ansi --no-sort --no-height \
            --preview "echo {} | grep -o '[a-f0-9]\{7\}' | head -1 |
                       xargs -I@ sh -c 'git show --color=always @'"
    )
    if [[ -n $selection ]]; then
        local commit=$(echo "$selection" | sed 's/^[* |]*//' | awk '{print $1}' | tr -d '\n')
        git show $commit
    fi
}

fi

