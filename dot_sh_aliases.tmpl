# Shared aliases and functions for interactive Bash and Zsh.

# ---- Dependency checks ----

shortcutIfInstalled() {
    type "$2" >/dev/null 2>&1 && alias "$1"="$2"
}

# Check at shell startup so installing a tool does not require chezmoi apply.
commandsAvailable() {
    local dependency
    for dependency in "$@"; do
        command -v "$dependency" >/dev/null 2>&1 || return 1
    done
}

# ---- Colors ----

# Use native colors when supported; keep redirected output plain.
for color_cmd in ls dir vdir grep diff; do
    if command "$color_cmd" --color=auto --help >/dev/null 2>&1; then
        alias "$color_cmd=$color_cmd --color=auto"
    fi
done
unset color_cmd

{{ if eq .chezmoi.os "darwin" -}}
# macOS's built-in ls uses -G.
alias ls='ls -G'
{{ end -}}

# Optionally color commands without native support using grc.
if commandsAvailable grc; then
    for color_cmd in ping traceroute dig netstat ps df du mount; do
        commandsAvailable "$color_cmd" &&
            alias "$color_cmd=grc --colour=auto $color_cmd"
    done
    unset color_cmd
fi

# ---- Everyday shortcuts ----

shortcutIfInstalled lv lvim
if commandsAvailable bat; then
    shortcutIfInstalled bcat bat
else
    shortcutIfInstalled bcat batcat
fi
shortcutIfInstalled fdf fdfind

alias cpi="cp -i" # Confirm before overwriting.
alias dfh="df -h" # Human-readable sizes.
commandsAvailable less && alias lessmore="less"
commandsAvailable flatpak && alias network-displays="G_MESSAGES_DEBUG=all flatpak run org.gnome.NetworkDisplays"

# ---- Safe deletion ----

# Keep rm recoverable. Unsupported flags fail; permanent deletion is explicit.
safe_rm() {
    local arg file force_delete=0 ignore_missing=0 options=1
    local files=() original=("$@")

    # Explicit permanent deletion forwards the remaining arguments to rm.
    for arg in "$@"; do
        if [ "$options" -eq 1 ]; then
            case "$arg" in
                --)
                    options=0
                    continue
                    ;;
                --really-delete|--force-delete)
                    force_delete=1
                    continue
                    ;;
            esac
        fi
        files+=("$arg")
    done
    if [ "$force_delete" -eq 1 ]; then
        command rm "${files[@]}"
        return $?
    fi

    # Trash accepts recursive/force flags only; reject all other options.
    files=()
    options=1
    for arg in "${original[@]}"; do
        if [ "$options" -eq 1 ]; then
            case "$arg" in
                --)
                    options=0
                    continue
                    ;;
                -) ;;
                -*)
                    case "$arg" in
                        *[!rRf-]*)
                            printf 'safe_rm: unsupported option: %s\n' "$arg" >&2
                            return 2
                            ;;
                    esac
                    case "$arg" in
                        *f*) ignore_missing=1 ;;
                    esac
                    continue
                    ;;
            esac
        fi
        files+=("$arg")
    done

    # Absolute paths keep filenames beginning with a dash unambiguous.
    local targets=()
    for file in "${files[@]}"; do
        if [ "$ignore_missing" -eq 1 ] && [ ! -e "$file" ] && [ ! -L "$file" ]; then
            continue
        fi
        case "$file" in
            /*) targets+=("$file") ;;
            *) targets+=("$PWD/$file") ;;
        esac
    done
    [ "${#targets[@]}" -gt 0 ] || return 0

    case "$(uname -s)" in
        Darwin)
            if [ -x /usr/bin/trash ]; then
                /usr/bin/trash "${targets[@]}"
            elif commandsAvailable trash; then
                command trash "${targets[@]}"
            else
                printf 'safe_rm: native trash command is unavailable; nothing deleted\n' >&2
                return 1
            fi
            ;;
        Linux)
            if commandsAvailable gio; then
                command gio trash -- "${targets[@]}"
            elif commandsAvailable trash-put; then
                command trash-put -- "${targets[@]}"
            else
                printf 'safe_rm: install gio or trash-cli; nothing deleted\n' >&2
                return 1
            fi
            ;;
        *)
            printf 'safe_rm: unsupported OS; nothing deleted\n' >&2
            return 1
            ;;
    esac
}
alias rm='safe_rm'

# ---- Chezmoi and tmux ----

# ch st / ch di: abbreviate status and diff; pass other commands through.
chezmoiAliased() {
    if [ $# -eq 1 ]; then
        if [ "$1" = "st" ]; then
            chezmoi status
        elif [ "$1" = "di" ]; then
            chezmoi diff
        else
            chezmoi "$@"
        fi
    else
        chezmoi "$@"
    fi
}
commandsAvailable chezmoi && alias ch=chezmoiAliased

commandsAvailable tmux && alias tx="tmux -L clifford-human-only"

# ---- Containers and Kubernetes ----

shortcutIfInstalled kc kubectl
shortcutIfInstalled kx kubectx
commandsAvailable minikube && alias mkc="minikube kubectl --"
shortcutIfInstalled pd podman
shortcutIfInstalled pdc podman-compose

# ---- Development commands ----

commandsAvailable bun && alias buni="bun i -g --ignore-scripts"

# watchpytest [directory]: rerun pytest when Python files change.
if commandsAvailable entr uv && { commandsAvailable fd || commandsAvailable fdfind; }; then
    watchpytest() {
        local watch_dir=${1:-"./"} finder
        finder=$(command -v fd || command -v fdfind)
        "$finder" . -e py "$watch_dir" | entr -d uv run pytest "$watch_dir"
    }
fi

commandsAvailable uvx && alias mitm="uvx mitmproxy"
commandsAvailable bunx && alias ai="bunx opencode-ai run -m 'opencode/kimi-k2.5-free'"

# ---- Fuzzy finders ----

if commandsAvailable fzf-tmux tmux lvim && { commandsAvailable fd || commandsAvailable fdfind; }; then
    # fvim: select files to open in LunarVim.
    fvim() {
        local finder file
        finder=$(command -v fd || command -v fdfind)
        "$finder" --type f --hidden --exclude .git --print0 |
            fzf-tmux -p -- --read0 --print0 --exit-0 |
            while IFS= read -r -d '' file; do
                lvim "$file" < /dev/tty
            done
    }
fi

if commandsAvailable make fzf; then
    # fmake: select and run a Makefile target.
    fmake() {
        local target=$(
            make -qp |
                awk -F':' '/^[a-zA-Z0-9][^$#\/\t=]*:([^=]|$)/ {split($1,A,/ /);for(i in A)print A[i]}' |
                sort -u |
                fzf --header="Select Makefile Target"
        )
        [ -n "$target" ] && make "$target"
    }
fi

if commandsAvailable git fzf; then
    # flog [git log arguments]: select and inspect a commit.
    flog() {
        local selection=$(
            git lo --color=always "$@" | \
                fzf --no-multi --ansi --no-sort --no-height \
                    --preview "echo {} | grep -o '[a-f0-9]\{7\}' | head -1 |
                           xargs -I@ sh -c 'git show --color=always @'"
        )
        if [[ -n $selection ]]; then
            local commit=$(echo "$selection" | sed 's/^[* |]*//' | awk '{print $1}' | tr -d '\n')
            git show $commit
        fi
    }
fi
