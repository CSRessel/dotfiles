overrideIfInstalled () {
    type "$2" >/dev/null 2>&1 && alias "$1"="$2"
}

# Check at shell startup so installing a tool does not require chezmoi apply.
commandsAvailable() {
    local dependency
    for dependency in "$@"; do
        command -v "$dependency" >/dev/null 2>&1 || return 1
    done
}


overrideIfInstalled vim lvim
overrideIfInstalled kc kubectl
overrideIfInstalled kx kubectx
if commandsAvailable bat; then
    overrideIfInstalled cat bat
else
    overrideIfInstalled cat batcat
fi
# overrideIfInstalled grep rg
overrideIfInstalled fd fdfind

chezmoiAliased() {
    if [ $# -eq 1 ]; then
        if [ "$1" = "st" ]; then
            chezmoi status
        elif [ "$1" = "di" ]; then
            chezmoi diff
        else
            chezmoi "$@"
        fi
    else
        chezmoi "$@"
    fi
}
commandsAvailable chezmoi && alias ch=chezmoiAliased

commandsAvailable tmux && alias tmux="tmux -L clifford-human-only"
alias cp="cp -i" # confirm before overwriting something
alias df="df -h" # human-readable sizes
commandsAvailable less && alias more="less"
commandsAvailable k9s && alias k9s="k9s --logoless"
